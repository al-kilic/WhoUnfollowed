# PostgreSQL
POSTGRES_USER=igtracker
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=igtracker
DATABASE_URL=postgresql://igtracker:changeme_strong_password@postgres:5432/igtracker

# App
NEXT_PUBLIC_APP_URL=https://whounfollowed.co

# Feature flags
NEXT_PUBLIC_PAYMENTS_ENABLED=false

# Auth (Lucia)
AUTH_SECRET=changeme_32_char_random_secret

# Stripe (set when ready to charge; requires NEXT_PUBLIC_PAYMENTS_ENABLED=true)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_PRICE_MONTHLY=price_...
# STRIPE_PRICE_YEARLY=price_...

# Cron
CRON_SECRET=changeme_random_secret

# Email (Resend). When RESEND_API_KEY is set, signup requires email verification
# and password reset becomes available. Leave unset to disable email features
# (signups are auto-verified). EMAIL_FROM must be on a domain verified in Resend.
# RESEND_API_KEY=re_...
# EMAIL_FROM=WhoUnfollowed <noreply@whounfollowed.co>

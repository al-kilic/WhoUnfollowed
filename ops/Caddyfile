whounfollowed.co {
    reverse_proxy web:3000

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    encode gzip

    log {
        output stdout
        format console
    }
}

analytics.whounfollowed.co {
    reverse_proxy umami:3001

    encode gzip

    log {
        output stdout
        format console
    }
}

admin.whounfollowed.co {
    # Password in front of NocoDB (a database admin tool). The bcrypt hash lives
    # only on the server, in the Caddy data volume, never in this repo:
    # /srv/ig-tracker/data/caddy/admin-auth.caddy holds `basic_auth { <user> <hash> }`.
    # Caddy refuses to load if that file is missing, so create it before deploying.
    import /data/admin-auth.caddy
    reverse_proxy nocodb:8080

    encode gzip

    log {
        output stdout
        format console
    }
}

# www has never been the canonical host. Redirect it permanently so shared or
# typed www links land on the real site instead of failing.
www.whounfollowed.co {
    redir https://whounfollowed.co{uri} permanent
}

# ─── WhoUnfollowed — Environment Variables ────────────────────────────────────
# Copy this file to .env.local and fill in values for local development.
# Never commit .env.local or any file containing real secrets.

# ── Site ──────────────────────────────────────────────────────────────────────
# Public URL of the deployment (used for canonical URLs, OG tags, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Payments ──────────────────────────────────────────────────────────────────
# Set to "true" to enable real Stripe checkout flows.
# Leave as "false" (or unset) during beta — all users get Pro access automatically.
NEXT_PUBLIC_PAYMENTS_ENABLED=false

# ── Email (optional) ──────────────────────────────────────────────────────────
# Resend API key for sending confirmation emails when users export CSV.
# If not set, the email feature is silently skipped — the app works fine without it.
# Get a key at https://resend.com
RESEND_API_KEY=

# ── Future / Pro tier (not yet active) ───────────────────────────────────────
# DATABASE_URL=postgresql://user:password@localhost:5432/whounfollowed
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# LUCIA_SECRET=a-long-random-string-at-least-32-chars

# ── Pro AI ────────────────────────────────────────────────────────────────────
# AI_PROVIDER=mock            # use the fake model locally and in tests
# OPENROUTER_API_KEY=
# Daily AI spend caps in USD (UTC day), counted from ai_usage_log, so they
# survive restarts. Unset = the default (25 overall, 1 per member); "0" turns a
# cap off. Overall: all AI pauses until midnight UTC and Telegram gets one alert.
# Per member: only that member waits until midnight UTC (fair-use message).
# AI_DAILY_SPEND_CAP_USD=25
# AI_USER_DAILY_SPEND_CAP_USD=1
# One-time Stripe Price for the credit top-up: 150 credits for $4.99 (lib/pricing.ts
# TOPUP_*). The env name is historical.
# STRIPE_PRICE_TOPUP_300=price_...

# Analyses run before or outside the live counter (backed by the founder's records).
# Added to the homepage total only; the average is unaffected.
STATS_ANALYSES_OFFSET=0

# AI health check (daily cron, lib/ai/aiHealth.ts). Alerts go to the alerts
# Telegram chat at most once a day per type. All optional; defaults shown.
AI_ALERT_CACHE_MIN_SHARE=0.2        # alert when a model reads less than this share of input from cache
AI_ALERT_CACHE_MIN_CALLS=30         # ...and made at least this many calls in 24h
AI_ALERT_SPEND_CAP_SHARE=0.7        # alert at this share of AI_DAILY_SPEND_CAP_USD
AI_ALERT_MEMBER_MONTHLY_USD=2       # alert when average cost per active member projects above this
AI_ALERT_SIGNAL_BACKLOG_HOURS=48    # alert when learning signals wait longer than this

# ── Pro AI launch offers (apps/web/lib/launchOffers.ts) ──────────────────────
# The day Pro AI goes live (YYYY-MM-DD, UTC). The old-yearly-Pro offer runs
# 90 days from it. Unset = 2026-12-01.
# PRO_AI_LAUNCH_DATE=2026-12-01
# Stripe coupon ids (Dashboard > Product catalogue > Coupons). Create them in
# the sandbox and in live; each mode has its own ids. Unset = no discount, the
# buyer pays full price (checkout never fails because of a missing coupon).
# Early Lifetime (bought before 2026-11-11): 60% off, duration Forever,
# applies to the Pro AI product. Used on MONTHLY Pro AI checkouts only.
# STRIPE_COUPON_INSIDER_MONTHLY=
# Old one-time yearly Pro buyers: $9.99 off, duration Once, applies to the Pro AI
# product. Used on YEARLY Pro AI checkouts inside the 90-day launch window.
# STRIPE_COUPON_YEARLY_LOYALTY=
# Live billing portal config (cancel at period end, no plan switching). Unset = account default.
# STRIPE_PORTAL_CONFIGURATION=bpc_...
# Launch emails grant + announce gifts; held until the founder announces them.
# LAUNCH_GIFTS_ENABLED=0

# ── Staging gate (beta testers) ───────────────────────────────────────────────
# Set ONLY on the staging server, never in production. When set, every page and
# API needs the access code first (/beta-access); Stripe webhooks, /api/health,
# /api/cron/* and /api/internal/* stay open. Read at runtime by the middleware
# and the /api/beta-access route (not a NEXT_PUBLIC_ variable, so Next.js does
# not inline it at build time): the same image runs with or without the gate.
# Changing the code signs every tester out of the gate.
# STAGING_ACCESS_CODE=
# Optional: forces the "Beta" badge on at build time. Without it the badge
# still shows on staging, from a cookie the gate sets at runtime.
# NEXT_PUBLIC_STAGING=1
